# Local auth: run `vercel link`, then `vercel env pull .env`.
# That writes VERCEL_OIDC_TOKEN, which authenticates both Sandbox and AI Gateway.
VERCEL_OIDC_TOKEN=

# Optional: an AI Gateway API key instead of the OIDC token
# AI_GATEWAY_API_KEY=

# Optional: snapshot ID to restore for faster Sandbox cold starts (lesson 5.2)
# SANDBOX_SNAPSHOT_ID=
